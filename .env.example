# Easiest: open the app and use the Connect AI page; it writes this file for you.

# Which AI to use: "anthropic" (your Anthropic API key), "openrouter" (your OpenRouter key) or "claude" (Claude Code
# on this Mac, for people who already use it, e.g. on a Claude Pro plan). "auto" (default) uses whichever key is set.
LLM_BACKEND=auto

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Anthropic model ids. Defaults shown.
# ANTHROPIC_WRITER_MODEL=claude-sonnet-5-5
# ANTHROPIC_CHECKER_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Or OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# WRITER_MODEL=anthropic/claude-sonnet-5.5
# CHECKER_MODEL=anthropic/claude-sonnet-5.5
# FAST_MODEL=anthropic/claude-haiku-5.5

# Claude Code models (aliases: haiku, sonnet, opus, fable). Defaults shown.
# CLAUDE_WRITER_MODEL=sonnet
# CLAUDE_CHECKER_MODEL=sonnet
# CLAUDE_FAST_MODEL=haiku

# How many times the writer may fix problems the checker finds before you see the draft.
MAX_FIX_ROUNDS=2
